rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra padrão: nega tudo que não for explicitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }

    // Isolamento por Usuário: Cada usuário acessa estritamente seus próprios dados
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcoleção de notas fiscais pertencentes ao usuário
      match /notas/{notaId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null 
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['linkNota'])
          && request.resource.data.linkNota is string
          && request.resource.data.linkNota.size() <= 2048;

        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Base Colaborativa de Preços: gravação e leitura direta pelo cliente bloqueadas;
    // acesso mediado e validado pela API FastAPI.
    match /precos_colaborativos/{registroId} {
      allow read, write: if false;
    }

    match /catalogo_produtos/{produtoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /estabelecimentos/{estabelecimentoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Auditoria interna de contribuições: estritamente restrita ao backend
    match /auditoria_contribuicoes/{notaHash} {
      allow read, write: if false;
    }
  }
}
